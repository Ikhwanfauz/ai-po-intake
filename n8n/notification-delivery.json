      "id": "7ad40000-0b03-4e73-9dda-000000000018",
      "name": "Send Gmail confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        920,
        160
      ],
      "retryOnFail": false,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const delivery = $('Dispatch claim').first().json;\nconst response = $input.first().json;\nconst isTelegram = delivery.channel === 'telegram';\nconst receipt = isTelegram ? response.result?.message_id ?? response.message_id : response.id;\nif (!response.error && receipt !== null && receipt !== undefined && String(receipt)) {\n  return [{ json: { outcome: 'sent', provider_receipt: String(receipt) } }];\n}\nconst error = typeof response.error === 'object' && response.error !== null ? response.error : response;\nconst rejection = error.response?.data ?? error.response?.body ?? error.cause?.response?.data\n  ?? error.cause?.response?.body ?? (isTelegram && response.ok === false ? response : null);\nconst explicitCode = isTelegram && rejection?.ok === false ? rejection.error_code\n  : (!isTelegram ? rejection?.error?.code : null);\n// Native nodes can flatten the status into a message. Only recognize exact rejection messages.\nconst message = typeof response.error === 'string' ? response.error.replace(/\\s+\\(item \\d+\\)$/, '') : '';\nconst standard = new Map([\n  ['Bad request - please check your parameters', 400],\n  ['Authorization failed - please check your credentials', 401],\n  ['Forbidden - perhaps check your credentials?', 403],\n  ['The resource you are requesting could not be found', 404],\n  ['The service is receiving too many requests from you', 429],\n]);\nconst telegram = new Map([\n  ['Unauthorized', 401],\n  ['Bad Request: chat not found', 400],\n  ['Forbidden: bot was blocked by the user', 403],\n  [\"Forbidden: bot can't initiate conversation with a user\", 403],\n]);\nconst nativeCode = isTelegram && /^Too Many Requests: retry after \\d+$/.test(message) ? 429\n  : (isTelegram ? telegram.get(message) ?? standard.get(message) : standard.get(message));\nconst code = explicitCode ?? nativeCode;\nif ([400, 401, 403, 404, 413, 422, 429].includes(code)) {\n  return [{ json: { outcome: 'failed', retryable: code === 429, error: 'Provider rejected the request (HTTP ' + code + ').' } }];\n}\nreturn [{ json: { outcome: 'unknown', error: 'No conclusive acknowledgement or rejection was available.' } }];"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000019",
      "name": "Classify provider result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1170,
        70
      ]
    },
