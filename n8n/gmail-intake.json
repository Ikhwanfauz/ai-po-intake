{
  "name": "Milestone 3 - Gmail PO intake",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 60
            }
          ]
        }
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000001",
      "name": "Poll schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "7ad40000-0b03-4e73-9dda-000000000002",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const labelId = 'Label_REPLACE_ME';\nif (labelId === 'Label_REPLACE_ME') throw new Error('Set the Gmail demo intake label ID in Intake settings.');\nreturn [{ json: { labelId } }];"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000003",
      "name": "Intake settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        70
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "labelIds",
              "value": "={{ $json.labelId }}"
            },
            {
              "name": "maxResults",
              "value": "25"
            },
            {
              "name": "q",
              "value": "has:attachment filename:pdf"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000004",
      "name": "List labeled Gmail messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        70
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($json.messages ?? []).map(message => ({ json: { id: message.id } }));"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000005",
      "name": "Expand message IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        70
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.id) }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "full"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000006",
      "name": "Read Gmail message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        70
      ]
    },
    {
      "parameters": {
        "jsCode": "function findPDFs(part, output) {\n  if (!part) return;\n  const filename = part.filename || 'attachment.pdf';\n  if (part.mimeType === 'application/pdf' || /\\.pdf$/i.test(part.filename || '')) {\n    const body = part.body || {};\n    output.push({\n      filename,\n      external_id: body.attachmentId || null,\n      attachment_id: body.attachmentId || 'part:' + (part.partId || 'root'),\n      inline_data: body.data || null,\n    });\n  }\n  for (const child of part.parts || []) findPDFs(child, output);\n}\nreturn $input.all().flatMap(({ json: message }, index) => {\n  const sender = (message.payload?.headers || []).find(header => header.name.toLowerCase() === 'from')?.value || '';\n  const pdfs = [];\n  findPDFs(message.payload, pdfs);\n  return pdfs.map(pdf => ({\n    json: { ...pdf, sender, message_id: message.id, expected_count: pdfs.length },\n    pairedItem: { item: index },\n  }));\n});"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000007",
      "name": "Expand PDF attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        70
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.message_id) + ($json.external_id ? '/attachments/' + encodeURIComponent($json.external_id) : '?format=minimal') }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000008",
      "name": "Read attachment bytes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        70
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "http://host.docker.internal:8003/integrations/gmail/intakes",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const pdf = $('Expand PDF attachments').item.json; return { message_id: pdf.message_id, attachment_id: pdf.attachment_id, sender: pdf.sender, filename: pdf.filename, pdf_base64: pdf.external_id ? ($json.body?.data || '') : (pdf.inline_data || '') }; })()) }}"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000009",
      "name": "Accept PDF in FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1610,
        70
      ]
    },
    {
      "parameters": {
        "jsCode": "const groups = new Map();\nfor (const [index, { json: response }] of $input.all().entries()) {\n  const pdf = $('Expand PDF attachments').itemMatching(index).json;\n  const group = groups.get(pdf.message_id) || { accepted: 0, expected: pdf.expected_count };\n  if ([200, 201].includes(response.statusCode)) group.accepted += 1;\n  groups.set(pdf.message_id, group);\n}\nreturn [...groups.entries()].filter(([, group]) => group.accepted === group.expected)\n  .map(([id]) => ({ json: { id } }));"
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000010",
      "name": "Collect accepted messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        70
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "method": "POST",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.id) + '/modify' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ removeLabelIds: [$('Intake settings').first().json.labelId] }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "7ad40000-0b03-4e73-9dda-000000000011",
      "name": "Remove processed intake label",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2070,
        70
      ]
    }
  ],
  "connections": {
    "Manual run": {
      "main": [
        [
          {
            "node": "Intake settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll schedule": {
      "main": [
