          }
        ]
      ]
    },
    "Collect accepted messages": {
      "main": [
        [
          {
            "node": "Remove processed intake label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 120,
    "saveDataSuccessExecution": "none"
  },
  "pinData": {},
  "tags": []
